{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node .github/hooks/log-interaction.cjs",
        "timeoutSec": 10
      }
    ]
  }
}